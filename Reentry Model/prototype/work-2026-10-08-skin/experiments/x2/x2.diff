+    s = m.surface()
+    p = m.points
+    walls = np.flatnonzero((np.abs(p[:, 1]) < 1e-12) | (np.abs(p[:, 1] - ly) < 1e-12) | (np.abs(p[:, 2]) < 1e-12)
+                           | (np.abs(p[:, 2] - lz) < 1e-12) | (np.abs(p[:, 0] - lx) < 1e-12))

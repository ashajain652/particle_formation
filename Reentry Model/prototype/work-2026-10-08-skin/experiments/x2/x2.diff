+@pytest.mark.parametrize("t", [0.5e-3, 1.0e-3, 2.0e-3])
+def test_x2_layered_box_mesh(t):
+    """The 8 x 10 x 10 mm box as prism layers of thickness t on 2 mm triangles: the volume is exact, every element is a
+    third of its prism and positively oriented, the boundary is the closed box (no face left single inside it), the
+    x = 0 face is made of layer 0's top triangles held by the tetrahedra that carry all three of their nodes, and
+    element_layer counts the layers from x = 0."""
+    lx, ly, lz, h = 8e-3, 10e-3, 10e-3, 2e-3
+    m = mesh.layered_box_mesh(lx, ly, lz, h, t)
+    ny, nz, nl = 5, 5, int(round(lx / t))
+    assert m.n_elements == 3 * 2 * ny * nz * nl and m.n_nodes == (ny + 1) * (nz + 1) * (nl + 1)
+    assert m.volume() == pytest.approx(lx * ly * lz, rel=1e-12)
+    x = m.points[m.tets]
+    signed = np.linalg.det(np.stack([x[:, 1] - x[:, 0], x[:, 2] - x[:, 0], x[:, 3] - x[:, 0]], axis=2)) / 6.0
+    assert np.allclose(signed, h * h * t / 6.0, rtol=1e-9)                  # half a square times t, over three
+    s = m.surface()
+    assert s.n_patches == 2 * (2 * ny * nz) + 2 * (2 * ny * nl) + 2 * (2 * nz * nl)
+    assert s.area == pytest.approx(2 * (ly * lz + lx * ly + lx * lz), rel=1e-12)
+    assert np.abs((s.areas[:, None] * s.normals).sum(axis=0)).max() < 1e-12 * s.area

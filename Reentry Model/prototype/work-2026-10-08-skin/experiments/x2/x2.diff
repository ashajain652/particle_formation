+def test_x2_cover_exposed_v2_withholds_a_skin_only_while_an_exposed_face_faces_away(coarse_sphere_mesh):
+    """cover_exposed_v2: above the solidus, a face a death exposed gets no created skin while it faces away from the
+    smoothed surface (n . n_s <= 0), re-evaluated at every creation; an exposed face that faces the smoothed surface,
+    and a face no death exposed even if it faces away, keep the solidus rule; liquid on a face still gives it a skin.
+    The smoothed normals are replaced by controlled ones (per face id, so they follow the surface through deaths).
+    Without the switch every face gets a skin. The books close."""
+    for on in (False, True):
+        b = make_body(coarse_sphere_mesh, solver_options=EXACT, cover_exposed_v2=on)
+        away_faces = set()
+
+        def controlled():
+            s = b.surface
+            flip = np.isin(s.face_ids, np.fromiter(away_faces, dtype=np.int64, count=len(away_faces)))
+            return s.normals * np.where(flip, -1.0, 1.0)[:, None]
+
+        b.smoothed_normals_x2 = controlled
+        e = int(b.surface.owner[0])
+        b.phi[e] = body.PHI_DEATH
+        b.solver.set_fractions(b.phi)
+        b.mass0, b.energy0 = b.mass(0.0), b.energy()
+        b.advance(0.5, 0.5, uniform(b, 1e5))                   # cold, no skins: the element dies, its rest becomes film
+        assert not b.mesh.active[e] and b.skins.n == 0
+        exposed = np.flatnonzero(np.isin(b.surface.face_ids, np.fromiter(b.exposed_faces, dtype=np.int64)))
+        assert exposed.size >= 2
+        A, B = (int(b.surface.face_ids[k]) for k in exposed[:2])
+        C = int(b.surface.face_ids[np.flatnonzero(~np.isin(b.surface.face_ids, list(b.exposed_faces)))[0]])
+        L = b.m_f + b.m_d                                      # the liquid leaves, booked at its enthalpy (the box's rule)
+        b.removed_mass += float(L.sum())
+        b.removed_enthalpy += float((L * b.film_enthalpy()).sum())
+        b.m_f[:], b.m_d[:] = 0.0, 0.0
+        b.solver.set_film_mass(b._film_nodal())
+        E = b.energy()                                         # the whole body above the solidus, the books shifted with it
+        b.solver.set_temperature(860.0)
+        b.energy0 += b.energy() - E
+        away_faces.update((A, B, C))
+        b._create_skins(b.solver.temperature())
+        pa, pb, pc = (int(b.patch_of_face[f]) for f in (A, B, C))
+        others = np.ones(b.surface.n_patches, dtype=bool)
+        others[[pa, pb]] = False
+        assert (b.skin_of_patch[others] >= 0).all() and b.skin_of_patch[pc] >= 0
+        if not on:
+            assert b.skin_of_patch[pa] >= 0 and b.skin_of_patch[pb] >= 0 and b.cover_v2_withheld == 0
+        else:
+            assert b.skin_of_patch[pa] < 0 and b.skin_of_patch[pb] < 0 and b.cover_v2_withheld == 2
+            assert b._create_skins(b.solver.temperature()) == 0 and b.cover_v2_withheld == 4      # re-read: still away
+            E, M = b.energy(), b.mass(0.0)                     # liquid arrives on A: it gets a skin to sit on
+            b.m_f[pa] = 1e-9
+            b.solver.set_film_mass(b._film_nodal())
+            b.energy0 += b.energy() - E
+            b.mass0 += b.mass(0.0) - M
+            assert b._create_skins(b.solver.temperature()) == 1 and b.skin_of_patch[pa] >= 0 and b.skin_of_patch[pb] < 0
+            away_faces.discard(B)                              # B now faces the smoothed surface: the solidus rule again
+            assert b._create_skins(b.solver.temperature()) == 1 and b.skin_of_patch[pb] >= 0
+        b.advance(1.0, 0.5, uniform(b, 1e5))
+        assert_books(b)

+def layered_box_mesh(lx, ly, lz, h, t):
+    """Experiment X2 (2026-10-09): the box [0, lx] x [0, ly] x [0, lz] as prism layers. The y-z cross-section is
+    triangulated as squares of side ~h, each split into two triangles along the same diagonal, and extruded along x in
+    uniform layers of thickness ~t (x = 0 is the heated face); each prism is split into three tetrahedra by
+    `split_prisms` (conforming), its "top" the face nearer x = 0, so the x = 0 face is made of the top triangles of
+    layer 0. `element_layer` is the layer index counted from x = 0. Elements are oriented positively."""
+    ny, nz, nl = (max(1, int(round(L / s))) for L, s in ((ly, h), (lz, h), (lx, t)))
+    Y, Z = np.meshgrid(np.linspace(0.0, ly, ny + 1), np.linspace(0.0, lz, nz + 1), indexing="ij")
+    yz = np.column_stack([Y.ravel(), Z.ravel()])
+    npl = len(yz)                                                  # nodes per x-plane
+    xs = np.linspace(0.0, lx, nl + 1)
+    points = np.vstack([np.column_stack([np.full(npl, x), yz]) for x in xs])
+    pid = np.arange(npl).reshape(ny + 1, nz + 1)
+    a, b, c, d = pid[:-1, :-1].ravel(), pid[1:, :-1].ravel(), pid[1:, 1:].ravel(), pid[:-1, 1:].ravel()
+    tri = np.vstack([np.column_stack([a, b, c]), np.column_stack([a, c, d])])     # each square along its a-c diagonal
+    tets = np.vstack([split_prisms((k + 1) * npl + tri, k * npl + tri) for k in range(nl)])
+    layer = np.repeat(np.arange(nl, dtype=np.int64), 3 * len(tri))
+    x = points[tets]
+    neg = np.linalg.det(np.stack([x[:, 1] - x[:, 0], x[:, 2] - x[:, 0], x[:, 3] - x[:, 0]], axis=2)) < 0.0
+    tets[neg] = tets[neg][:, [0, 1, 3, 2]]                         # same faces, positive orientation
+    return VolumeMesh(points, tets, {"box": (lx, ly, lz), "h": h, "layer_thickness_m": (lx / nl), "layers": nl,
+                                     "path": None}, layer)

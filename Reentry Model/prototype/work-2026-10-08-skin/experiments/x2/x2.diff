+def test_x2_smoothed_normal_options_hold_the_walls_and_keep_each_patch_s_orientation():
+    """orient=False changes nothing where the smoothing folds no triangle; holding the walls of the box keeps its
+    intact front exactly flat (the default rounds the edges, tilting the front's edge patches), and a held wall

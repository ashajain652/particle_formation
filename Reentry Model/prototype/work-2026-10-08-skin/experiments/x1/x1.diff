+# -- experiment X1 (2026-10-09): two candidate fixes for the skins' stall in the box, as switches, off by default ---------
+
+def test_x1_draw_through_takes_from_the_element_behind_an_exhausted_owner(coarse_sphere_mesh):
+    """draw_through: a skin whose owner has nothing above PHI_DEATH draws from the element behind it -- the owner's
+    active face-neighbour furthest along the patch's inward normal -- debited there; without the switch the same skin
+    draws nothing. The books close either way."""
+    drawn = {}
+    for on in (False, True):
+        b = make_body(coarse_sphere_mesh, solver_options=EXACT, draw_through=on)
+        nxt = b._next_element(np.arange(b.surface.n_patches))
+        # a patch whose next element is buried (owns no patch), so that nothing but the draw moves its fraction
+        cand = np.flatnonzero((nxt >= 0) & (b.owner_area[np.maximum(nxt, 0)] == 0.0))
+        assert cand.size
+        p = int(cand[0])
+        e, n = int(b.surface.owner[p]), int(nxt[p])
+        assert b.mesh.active[n] and n != e
+        b.phi[e] = body.PHI_DEATH + 0.01                       # its element can give the new skin only a sliver
+        b.solver.set_fractions(b.phi)
+        b.m_f[p] = 1e-9                                        # liquid on the patch: it alone gets a skin at 300 K
+        b.solver.set_film_mass(b._film_nodal())
+        b.mass0, b.energy0 = b.mass(0.0), b.energy()
+        b._create_skins(b.solver.temperature())
+        assert b.skins.n == 1 and b.skins.thickness()[0] < 0.5 * DEV.thickness
+        own, through, n_of = b._skin_available_through(b.patch_of_skin)
+        assert n_of[0] == n and own[0] < 1e-12 * b.element_mass[e] and through[0] > b.material.rho * b.skins.area[0] * DEV.thickness
+        phi_n0 = b.phi[n]
+        b.advance(0.5, 0.5, uniform(b, 1e5))
+        drawn[on] = b.skin_drawn_mass
+        if on:
+            assert b.skin_drawn_through_mass > 0.0
+            assert b.skin_drawn_through_mass == pytest.approx(b.skin_drawn_mass, rel=1e-9)     # its owner gave nothing
+            assert b.phi[n] == pytest.approx(phi_n0 - b.skin_drawn_through_mass / b.element_mass[n], rel=1e-12)
+            assert b.phi[n] > body.PHI_DEATH
+        else:
+            assert b.skin_drawn_through_mass == 0.0 and b.phi[n] == phi_n0
+        assert not b.mesh.active[e]                             # the drained owner died either way
+        assert_books(b)
+    assert drawn[False] < 1e-12 * drawn[True] and drawn[True] > 0.0
+
+
+def test_x1_cover_exposed_gives_no_created_skin_to_a_face_a_death_exposed(coarse_sphere_mesh):
+    """cover_exposed: the faces a death exposes are recorded (whatever the switch), and with the switch the solidus test
+    leaves them out -- above the solidus they get no created skin -- while liquid arriving on one still gives it a skin
+    to sit on; without the switch they get skins at the solidus like every other face. The books close."""
+    for on in (False, True):
+        b = make_body(coarse_sphere_mesh, solver_options=EXACT, cover_exposed=on)
+        e = int(b.surface.owner[0])
+        b.phi[e] = body.PHI_DEATH
+        b.solver.set_fractions(b.phi)
+        b.mass0, b.energy0 = b.mass(0.0), b.energy()
+        b.advance(0.5, 0.5, uniform(b, 1e5))                   # cold, no skins: the element dies, its rest becomes film
+        assert not b.mesh.active[e] and b.skins.n == 0
+        new = np.isin(b.surface.face_ids, np.fromiter(b.exposed_faces, dtype=np.int64))
+        assert new.sum() >= 1 and set(b.surface.face_ids[new].tolist()) == b.exposed_faces
+        assert set(b.exposed_faces) <= set(b.mesh.element_faces([e])[0].tolist())
+        L = b.m_f + b.m_d                                      # the liquid leaves, booked at its enthalpy (the box's rule)
+        b.removed_mass += float(L.sum())
+        b.removed_enthalpy += float((L * b.film_enthalpy()).sum())
+        b.m_f[:], b.m_d[:] = 0.0, 0.0
+        b.solver.set_film_mass(b._film_nodal())
+        E = b.energy()                                         # the whole body above the solidus, the books shifted with it
+        b.solver.set_temperature(860.0)
+        b.energy0 += b.energy() - E
+        b._create_skins(b.solver.temperature())
+        if on:
+            assert (b.skin_of_patch[new] < 0).all() and (b.skin_of_patch[~new] >= 0).all()
+            q = int(np.flatnonzero(new)[0])                    # liquid arrives on one of them: it gets a skin
+            E, M = b.energy(), b.mass(0.0)
+            b.m_f[q] = 1e-9
+            b.solver.set_film_mass(b._film_nodal())
+            b.energy0 += b.energy() - E
+            b.mass0 += b.mass(0.0) - M
+            assert b._create_skins(b.solver.temperature()) == 1 and b.skin_of_patch[q] >= 0
+            dry = new.copy()
+            dry[q] = False
+        else:
+            assert (b.skin_of_patch >= 0).all()
+        b.advance(1.0, 0.5, uniform(b, 1e5))
+        if on:
+            assert (b.skin_of_patch[dry] < 0).all()
+        assert_books(b)

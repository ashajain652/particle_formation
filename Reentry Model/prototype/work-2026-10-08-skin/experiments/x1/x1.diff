+    def _next_element(self, patches):
+        """X1 draw_through: per patch, the active face-neighbour of its owner element that lies furthest along the
+        patch's inward normal (centroid to centroid, the step `_molten_chain` takes inward); -1 where no active
+        neighbour lies inward of the owner."""
+        mesh, s = self.mesh, self.surface
+        patches = np.asarray(patches, dtype=np.int64)
+        cur = s.owner[patches]
+        pair = mesh._face_elements[mesh.element_faces(cur)]                                   # (n, 4, 2)
+        nb = np.where(pair[:, :, 0] == cur[:, None], pair[:, :, 1], pair[:, :, 0])
+        ok = (nb >= 0) & mesh.active[np.maximum(nb, 0)]
+        c_cur = mesh.points[mesh.tets[cur]].mean(axis=1)
+        c_nb = mesh.points[mesh.tets[np.maximum(nb, 0)]].mean(axis=2)                        # (n, 4, 3)
+        step = np.where(ok, np.einsum("nkj,nj->nk", c_nb - c_cur[:, None, :], -s.normals[patches]), -np.inf)
+        rows = np.arange(cur.size)
+        pick = step.argmax(axis=1)
+        good = ok[rows, pick] & (step[rows, pick] > 0.0)
+        return np.where(good, nb[rows, pick], -1)
+
+    def _skin_available_through(self, patches):
+        """X1 draw_through: (from the owner [kg], from the next element [kg], the next element or -1) per skin patch.
+        Each element's metal above PHI_DEATH is shared by area among every claim on it: its own patches (as
+        `_skin_available` shares it) and the skins on other elements' patches whose next element it is. An element no
+        skin chains into gives its patches exactly `_skin_available`'s shares; one that is also a next element gives
+        its own patches less, so that no element is ever drawn below PHI_DEATH."""
+        s = self.surface
+        patches = np.asarray(patches, dtype=np.int64)
+        e = s.owner[patches]
+        nxt = self._next_element(patches)
+        has = nxt >= 0
+        A = s.areas[patches]
+        claim = self.owner_area + np.bincount(nxt[has], A[has], self.mesh.n_elements)
+        pool = np.maximum(self.phi - PHI_DEATH, 0.0) * self.element_mass
+        own = np.maximum(self.phi[e] - PHI_DEATH, 0.0) * self.element_mass[e] * (A / claim[e])
+        nx = np.zeros(patches.size)
+        nx[has] = pool[nxt[has]] * (A[has] / claim[nxt[has]])
+        return own, nx, nxt
